# Environment example for NID

# Backend
NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/nid_db
REDIS_URL=redis://localhost:6379
JWT_ACCESS_TOKEN_SECRET=replace_with_secure_random
JWT_REFRESH_TOKEN_SECRET=replace_with_secure_random

# Firebase service account (for server-side verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=

# OpenAI
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Google
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_DIRECTIONS_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NID_MEDIA=
AWS_CLOUDFRONT_DISTRIBUTION_ID=

# Firebase mobile config (store paths or base64 blobs)
ANDROID_FIREBASE_GOOGLE_SERVICES_JSON=
IOS_FIREBASE_GOOGLE_SERVICES_PLIST=

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=notifications@nid.example

# Optional: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Dev MinIO (S3 fallback)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# App
DOMAIN=http://localhost:3000
APP_ENV=development

# Sentry
SENTRY_DSN=
